# Windows Flutter ephemeral directory (generated by `flutter run`/`flutter build`).
# Contains engine DLL, ICU data, C++ wrapper sources, and generated_config.cmake.
# Must NOT be committed; Flutter regenerates it on every build.
windows/flutter/ephemeral/

